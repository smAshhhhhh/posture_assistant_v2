{
  "name": "postureassist-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": "^24.3.0",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "node scripts/checkAndroidBuild.mjs && expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "node --test src/**/*.test.mjs",
    "export:android": "expo export --platform android",
    "doctor:local": "node scripts/checkEnvironment.mjs"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "58.0.23",
    "expo-dev-client": "58.0.18",
    "expo-system-ui": "58.0.7",
    "heroui-native": "1.0.11",
    "lucide-react-native": "1.70.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.2.2",
    "tailwindcss": "4.3.4",
    "uniwind": "1.13.2"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.24",
    "eslint": "9.39.1",
    "eslint-config-expo": "58.0.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
